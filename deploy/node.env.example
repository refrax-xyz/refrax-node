# /etc/refrax/node.env — read by deploy/refrax-node.service
REFRAX_REGISTRY=https://registry.example
REFRAX_KEY=/var/lib/refrax/keypair.json
REFRAX_DATA_DIR=/var/lib/refrax
REFRAX_LISTEN=127.0.0.1:7701
# The URL peers and clients use; put TLS in front (see docs/running-a-node.md)
REFRAX_PUBLIC_URL=https://node.example.com
REFRAX_STAKE=2500
# Log filter, e.g. refrax_node=debug
REFRAX_LOG=refrax_node=info
